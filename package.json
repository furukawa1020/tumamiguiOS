{
  "name": "tsumamigui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pinch-and-eat interaction demo with MediaPipe + p5.js",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --strictPort",
    "lint": "eslint src tests e2e --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run tests",
    "test:e2e": "playwright test --reporter=line",
    "assets": "node scripts/fetch-mediapipe-assets.mjs && node scripts/copy-mediapipe-wasm.mjs && npm run generate-social-assets",
    "generate-social-assets": "node scripts/generate-social-assets.mjs",
    "capture-og-image": "node scripts/generate-social-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "check:full": "npm run format:check && npm run check",
    "check:strict": "npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10",
    "p5": "1.11.8"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@playwright/test": "1.50.1",
    "@types/node": "22.13.5",
    "@typescript-eslint/eslint-plugin": "8.22.0",
    "@typescript-eslint/parser": "8.22.0",
    "eslint": "^8.57.0",
    "playwright": "1.50.1",
    "prettier": "3.4.1",
    "typescript": "5.8.2",
    "vite": "5.4.19",
    "vitest": "2.1.8"
  }
}
